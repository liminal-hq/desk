# 86Box (the Linux AppImage, unpacked) and its ROM set, with a virtual X server, for the native track's third-emulator run.
# tools/native-run-86box.sh builds this once as desk-native-86box:1. Nothing from it is committed or redistributed: the image is built
# on the user's machine from the upstream release assets (86Box is GPL-2.0-or-later; the ROM images keep their own terms, see
# https://github.com/86Box/roms).
FROM ubuntu:24.04
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl xvfb xauth x11-utils xdotool \
        imagemagick python3 libgl1 libegl1 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-render-util0 libxcb-xinerama0 libxcb-xkb1 libxcb-shape0 libfontconfig1 libdbus-1-3 libglib2.0-0 libasound2t64 \
        libsndio7.0 libopenal1 libevdev2 libslirp0 libpng16-16 libsdl2-2.0-0 libfreetype6 \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; cd /tmp; \
    curl -fsSL -o 86box.AppImage https://github.com/86Box/86Box/releases/download/v6.0/86Box-Linux-x86_64-b9001.AppImage; \
    echo '535d3c329f8c32b601103970c86d80aa80298f345452c3524ea2f433624727a4  86box.AppImage' | sha256sum -c -; \
    chmod +x 86box.AppImage; ./86box.AppImage --appimage-extract > /dev/null; mv squashfs-root /opt/86box; rm 86box.AppImage; \
    curl -fsSL -o roms.tar.gz https://github.com/86Box/roms/archive/refs/tags/v6.0.tar.gz; \
    echo '38fccaf4a7b48e581ccdfee2dc3cc0545e7d3a778bc25611e902a117eec571e6  roms.tar.gz' | sha256sum -c -; \
    mkdir /opt/roms; tar xzf roms.tar.gz -C /opt/roms --strip-components=1; rm roms.tar.gz
